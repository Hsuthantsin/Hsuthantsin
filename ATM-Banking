public static double checkBalance(double balance) {
	System.out.println("Current Balance:" +balance);
	return balance;
}
public static double deposit(Scanner sc,double balance) {
	 System.out.println("Enter Your Deposit Amount");
		 double deposit=sc.nextDouble();
		 
		if(deposit>0) {
		 balance+=deposit;
		 history+="Deposited:"+deposit+"\n";
		System.out.println("Successfully your deposit:");
		System.out.println("Your New balance:" + balance);
		}else
		System.out.println("Invalid your deposit Please enter positive amount! Thank You!");
    return balance;
}
public static double withdraw(Scanner sc,double balance) {
	 System.out.println("Enter Withdraw Amount");
	 double withdraw=sc.nextDouble();
	 if(withdraw<=0)
		 System.out.println("Invalid your withdraw amount.Please enter positive amount!");
	 else if(withdraw>balance)
		 System.out.println("Insufficient balance ! Try again!");
	 else
	 {
		 balance-=withdraw;
		 history+="Withdraw:" +withdraw +"\n";
		 System.out.println("Your Withdraw Successfully!" +withdraw);
		 System.out.println("New Balance :" +balance);
	 }

	return balance;
}
public static boolean login(Scanner sc) {
	 int correctPin = 423165;
      int attempts=3;
      while(attempts>0) {
    	  System.out.println("Enter Your PIN ");
    	  int enteredpin=sc.nextInt();
    	  if(enteredpin==correctPin)
    	  {
    		  System.out.println("Login Successfully!");
    		  return true;
    	  }
    	  else
    	  {
    		  System.out.println("Wrong PIN! Try again");
    		  System.out.println("Remaining attempts:"+ attempts);
    		  attempts--;
    	  }
      }
      return false;
	
	
	
}
public static void showTransitionhistory() {
	System.out.println("\n Transition History :");
	
	if(history.isEmpty()) {
		System.out.println("No Transition yet!");
		}
	else
	{
           System.out.println(history);       

	}
}

